{
  "name": "pimcore/frontend-permission-toolkit-bundle",
  "description": "Provides a way to configure permissions for frontend applications in data objects.",
  "license": "proprietary",
  "type": "pimcore-bundle",
  "autoload": {
    "psr-4": {
      "FrontendPermissionToolkitBundle\\": "src/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.3.0 || ~8.4.0",
    "pimcore/pimcore": "^12.0",
    "pimcore/generic-data-index-bundle": "^2.1",
    "symfony/event-dispatcher-contracts": "^3.0",
    "pimcore/studio-backend-bundle": "^1.0"
  },
  "conflict": {
    "pimcore/pimcore": "<11.0.0-ALPHA6"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10"
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "FrontendPermissionToolkitBundle\\FrontendPermissionToolkitBundle"
      ]
    }
  }
}
