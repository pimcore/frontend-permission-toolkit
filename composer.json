{
  "name": "pimcore/frontend-permission-toolkit-bundle",
  "description": "Provides a way to configure permissions for frontend applications in data objects.",
  "license": "proprietary",
  "type": "pimcore-bundle",
  "autoload": {
    "psr-4": {
      "FrontendPermissionToolkitBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FrontendPermissionToolkitBundle\\Tests\\": "tests/"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.4.0 || ~8.5.0",
    "pimcore/pimcore": "^2026.3",
    "pimcore/generic-data-index-bundle": "^2026.1",
    "symfony/event-dispatcher-contracts": "^3.0",
    "pimcore/studio-backend-bundle": "^2026.1",
    "pimcore/studio-ui-bundle": "^2026.1"
  },
  "require-dev": {
    "codeception/codeception": "^5.3.7",
    "codeception/module-asserts": "^3.0",
    "phpstan/phpstan": "2.1.40",
    "phpunit/phpunit": "^12.5.23 || ^13.1.7"
  },
  "extra": {
    "branch-alias": {
      "dev-2026.x": "2026.1.x-dev"
    },
    "pimcore": {
      "bundles": [
        "FrontendPermissionToolkitBundle\\FrontendPermissionToolkitBundle"
      ]
    }
  }
}
